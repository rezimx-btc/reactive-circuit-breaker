# Demo / demo environment — copy to .env, NEVER commit the real one.
# The deployer/agent key file lives OUTSIDE the repo:
#   ~/.dorahacks-testnet/deployer.json  (chmod 600, created with cast wallet new)
DEPLOYER_KEY_FILE=$HOME/.dorahacks-testnet/deployer.json

BASE_SEPOLIA_RPC=https://sepolia.base.org
LASNA_RPC=https://lasna-rpc.rnk.dev/

# Filled by contracts/script/deploy.sh -> deployments.json
BREAKER_ADDRESS=
ORACLE_ADDRESS=
VAULT_ADDRESS=

# Groq: leave unset to use the registered connector helper
# (agent/verdict.mjs shells out to custom.groq groq.py — key never enters
# this process). Set GROQ_API_KEY only if you have your own key.
# GROQ_API_KEY=
